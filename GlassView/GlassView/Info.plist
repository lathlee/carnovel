<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    GlassView / Info.plist

    跟 CarNovel 一样，这里**故意没有** CarPlay 相关键：
      没有 UISceneConfigurations → CPTemplateApplicationSceneSessionRoleApplication
      没有 com.apple.developer.carplay-* entitlement

    我们不申请 CarPlay App，车机屏是 APTV 的浏览器在渲染，
    这个 App 只负责：起服务器 + 后台保活 + 提供页面。
-->
<plist version="1.0">
<dict>

    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>

    <key>CFBundleDisplayName</key>
    <string>Glass-view</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>

    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>MinimumOSVersion</key>
    <string>18.0</string>

    <key>UILaunchScreen</key>
    <dict/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!--
        ★ 核心：后台保活

        audio 是**唯一**真正起作用的那一条：
        循环播一段数字静音，让进程在息屏 / 切后台之后不被挂起，
        NWListener 才有机会继续接住快捷指令 POST 过来的通知。

        这里曾经还写过 network —— 那是错的。查 Apple 的 UIBackgroundModes 文档，
        合法取值只有：
            audio / bluetooth-central / bluetooth-peripheral / external-accessory /
            fetch / location / nearby-interaction / network-authentication /
            newsstand-content / processing / push-to-talk / remote-notification /
            screen-capture / voip
        里面**没有 network**（只有 network-authentication，那是给 Captive Portal 用的）。
        侧载时装个无效值不会报错，但它是错的，删掉。

        诚实说明：静音音频保活在 App Store 的审核口径下算违规
        （音频后台模式要求真的在播有声内容）。本 App 只侧载、不上架，所以能用；
        哪天要上架，这条路得换（例如 bluetooth-central + 真的 BLE 外设）。
        第二阶段做微信（BLE ANCS）时才需要再加 bluetooth-central。
    -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- 实时活动：锁屏 / 灵动岛 / CarPlay（iOS 26）实时显示最新通知。
         本地更新（Activity.update）不走小组件那套刷新调度，锁屏即时生效。 -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- 文件共享：方便把改好的 index.html 拖进去，不用重新编译 -->
    <key>UIFileSharingEnabled</key>
    <true/>

    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- 服务器只绑定 127.0.0.1，不监听局域网；但 WebView 走本地回环仍需说明 -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>在手机内部提供网页服务，供车载屏幕上的浏览器访问</string>

    <!-- 回环地址本身豁免 ATS，这里只是保险 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

</dict>
</plist>
