<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    CarNovel / Info.plist

    ⚠️ 注意这里**故意没有** CarPlay 相关的任何键：
        没有 UISceneConfigurations → CPTemplateApplicationSceneSessionRoleApplication
        没有 com.apple.developer.carplay-* entitlement

    这正是「车机屏上不出现 UI 控件」的原因 ——
    不是 CarPlay 应用，车机就只把它当成一个 AirPlay 视频画面来显示。
    同时这也让侧载简单很多：不需要向 Apple 申请任何 CarPlay 权限。
-->
<plist version="1.0">
<dict>

    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>

    <key>CFBundleDisplayName</key>
    <string>CarNovel</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>MinimumOSVersion</key>
    <string>17.0</string>

    <!--
        UIDeviceFamily 不在这里声明 —— 由 build setting TARGETED_DEVICE_FAMILY 控制
        （project.yml 里设成 "1"，即仅 iPhone）。
        两边都写的话 Xcode 会警告 "User supplied UIDeviceFamily key in the Info.plist
        will be overwritten"，因为它无条件用 build setting 覆盖这里。
    -->

    <key>UILaunchScreen</key>
    <dict/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!--
        后台音频：让 App 在手机息屏后继续持有 AirPlay 会话。
        投到车机之后手机就可以息屏了，靠的就是这个。
        注意这里只声明 audio —— 不声明 CarPlay 场景。
    -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!--
        文件共享：允许用 Finder / iTunes 把单页 mp4 直接拖进 App 的 Documents 目录。
        这样换小说内容不用重新编译，侧载的 7 天续签周期内能反复换内容。
    -->
    <key>UIFileSharingEnabled</key>
    <true/>

    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!--
        允许通过「共享」菜单把视频塞进来（AirDrop / 文件 App 等）
    -->
    <key>UISupportsDocumentBrowser</key>
    <false/>

    <!-- 走 AirPlay 到局域网内的车机，需要本地网络权限 -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>用于把画面投送到车载屏幕</string>

    <!-- 网络抓取小说内容 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

</dict>
</plist>
